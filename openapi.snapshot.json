    "/v1/staff/scheduling/waitlist": {
      "get": {
        "description": "The waiting queue, clinical priority first and join time second, optionally for one visit type.",
        "operationId": "list_waitlist_v1_staff_scheduling_waitlist_get",
        "parameters": [
          {
            "in": "query",
