# CareFlow — environment template (Phase 0)
#
# Copy to `.env` and fill in real values. `.env` is gitignored; ONLY this example file is tracked.
# NEVER paste real values into chat, issues, commits, or logs.
#
# Two separate hosted Supabase projects, both Tokyo (ap-northeast-1) — an accepted deviation for
# synthetic-data dev/CI (BUILD-SPEC.md §18.1); production must be an India region (§16.5). CLAUDE.md rule 12:
#   * dev  -> your local `.env`
#   * ci   -> GitHub Actions repository secrets, using the SAME variable names as below
#             (except CORS_ALLOWED_ORIGINS, which CI does not need — leave it out of CI secrets)
# No Docker anywhere. Synthetic data only in both projects (`demo` profile) — no real patient data.
#
# Only keys needed for Phase 0 are listed. Keys for later services (LLMs, Qdrant, Langfuse, SMS,
# email, Gemini, ...) are added in the phase that introduces them — and per CLAUDE.md rule 13,
# only after you approve the service.

# ---- Environment ------------------------------------------------------------------------------

# Which hosted project this file points at: dev | ci
CAREFLOW_ENV=dev

# Operating profile (BUILD-SPEC.md §2): demo | clinical. Use `demo` for dev and CI.
CAREFLOW_PROFILE=demo

# ---- Supabase project (Dashboard -> Project Settings -> API Keys) -----------------------------
# These projects use Supabase's new key system (publishable / secret), not the legacy
# anon / service_role JWT keys.

# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable key — starts with `sb_publishable_`. Safe to expose in a browser.
# NOT read by the backend at runtime (the backend verifies JWTs itself and talks to Postgres
# directly, BUILD-SPEC.md §18.1). Needed by: the test harness, to sign test users in with a
# password so the role-matrix test can obtain real JWTs; and, later, the frontend's browser Auth
# client.
SUPABASE_PUBLISHABLE_KEY=

# Secret key — starts with `sb_secret_`. SECRET, bypasses RLS. Must be a DIFFERENT value from the
# publishable key above.
# ONE-TIME SETUP ONLY (creating test accounts via the Auth admin API, BUILD-SPEC.md §21).
# Never used by the running app and never inside a test assertion. Leave blank in any
# environment that doesn't need to run setup.
SUPABASE_SECRET_KEY=

# JWT verification (BUILD-SPEC.md §18.1). Both projects are confirmed to use asymmetric JWT Signing
# Keys, so fill JWKS and leave JWT_SECRET blank — they are mutually exclusive.
# The verifier must pick the key by the token header's `kid`, never "the first key in the list":
# the JWKS can hold a current and a previous key during a rotation window.
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
#   Legacy shared secret. Leave BLANK for these projects.
SUPABASE_JWT_SECRET=

# ---- Database (Dashboard -> Connect) ----------------------------------------------------------
#
# Format (SQLAlchemy async + asyncpg):
#   postgresql+asyncpg://<user>:<password>@<host>:<port>/postgres
# (special characters in the password must be URL-encoded)
#
# Migration runner: use the SESSION-MODE POOLER string (pooler host, port 5432, user
# `postgres.<project-ref>`). Confirmed on both dev and CI to hold a session-level advisory lock
# across statements. Do NOT use the direct connection (IPv6-only on new projects; GitHub-hosted
# runners commonly lack IPv6) and do NOT use the transaction-mode pooler (port 6543), which can
# hand the connection to another caller mid-lock without erroring.

# Migration owner / schema-changing role. Used ONLY by the migration runner. SECRET.
DATABASE_URL_MIGRATOR=

# Restricted application role (`careflow_app`, NOBYPASSRLS). Leave BLANK until task 2 creates the
# role — do not point this at the `postgres` user (it bypasses RLS). This is what the API and the
# CI role-matrix/RLS tests connect as. SECRET. Never a superuser or an RLS-bypassing role.
DATABASE_URL_APP=

# ---- Demographic encryption (BUILD-SPEC.md §17.2; careflow/crypto.py) -----------------------------
# Local keys only: nothing here is sent to any service. One pair per key version; during a manual
# rotation two versions are present at once. Both are base64. Generate each with:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# The two values MUST differ. Losing the encryption key makes the stored demographics unrecoverable,
# so keep a backup in the hosting provider's secret manager. SECRET. Never commit real values.

# AES-256-GCM key for key_version 1: exactly 32 random bytes.
CAREFLOW_ENC_SECRET_V1=
# HMAC-SHA256 key for key_version 1 (identity tokens): at least 32 random bytes.
CAREFLOW_HMAC_SECRET_V1=

# ---- Step-up re-authentication (BUILD-SPEC.md §18.1) -------------------------------------------------
# How many seconds ago a staff member's second factor (TOTP) may have been verified for a sensitive action
# (the merge routes). REQUIRED, no default in code: while unset the merge routes answer 503. Not a secret.
# The token claim shape this reads is not yet verified against a real token: docs/design/step-up-spike.md.
CAREFLOW_STEP_UP_MAX_AGE_SECONDS=300
# Every staff route needs a verified second factor (aal2 + TOTP). ON by default. Setting it to false is accepted ONLY with CAREFLOW_PROFILE=demo and CAREFLOW_DATA_POLICY=synthetic_only; anywhere else the app refuses to start.
# CAREFLOW_REQUIRE_AAL2=true

# ---- In-process worker (BUILD-SPEC.md 7.4) ---------------------------------------------------------
# OFF unless set. When on, the API process runs the minute tick (and an immediate poke) over the Postgres queue, as a `queue_worker`
# account. The account id is a plain uuid, not a secret. With no handlers registered yet, jobs are dead-lettered visibly as "no handler".
CAREFLOW_RUN_WORKER=false
CAREFLOW_WORKER_ACCOUNT_ID=

# ---- Readiness (BUILD-SPEC.md 2) --------------------------------------------------------------------
# Comma list of model roles that must each have an enabled `phi_approved` route before a `clinical` deployment reports ready
# (GET /readyz). No default: which roles block launch is the owner's decision. Unset means "not configured", and a clinical
# deployment is then NOT ready. Roles: llm_large, llm_planner, llm_fast, vlm, embed, rerank, llm_judge, decision, voice_live.
# Recommended for a clinical launch (owner's recommendation, 2026-10-24; set the real value in the deployment, not here):
# CAREFLOW_REQUIRED_ROLES=decision,embed,llm_large
CAREFLOW_REQUIRED_ROLES=

# ---- App ---------------------------------------------------------------------------------------

# Allowed browser origin(s) for the API, comma-separated. Local development only — CI drives the
# API through a test client, not a browser, so this is not needed in CI secrets.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Patient view (docs/design/patient-view-fields.md; DEMO profile with synthetic data only) ------------------------
# Decrypted views of a patient's demographics for staff. OFF unless CAREFLOW_PROFILE=demo AND CAREFLOW_DATA_POLICY=synthetic_only. The two limits are REQUIRED and have NO default in code: while
# unset, opening a record / reading list rows answers 503. (The demo placeholders in config/demo-phase3.yaml fill them only when CAREFLOW_DEMO_PHASE3=1 under that gate; a value set here always wins.)
# Names only, left commented so a copied file does not set an empty (invalid) value. Not secrets.
# CAREFLOW_PATIENT_VIEW_MAX_OPENS_PER_MINUTE=
# CAREFLOW_PATIENT_VIEW_MAX_LABEL_ROWS_PER_MINUTE=
# CAREFLOW_PATIENT_VIEW_PAGE_LIMIT=

# ---- Document storage (docs/design/uploads-supabase-storage.md; dev and CI projects, SYNTHETIC data only) ------------------
# A private Supabase Storage bucket, created in the dashboard (name, private, size limit, allowed types: see the design note). Uploads stay UNAVAILABLE (503) until BOTH are set, the profile is demo with
# CAREFLOW_DATA_POLICY=synthetic_only, and SUPABASE_SECRET_KEY is present. CAREFLOW_STORAGE_VERIFIED is the date (YYYY-MM-DD) the owner confirmed the real service with scripts/storage_spike.py.
# Names only, commented so a copied file does not set an empty value.
# CAREFLOW_STORAGE_BUCKET=
# CAREFLOW_STORAGE_VERIFIED=

# Dev seeding scripts (scripts/seed_dev_demo_data.py): the ref of the DEV Supabase project (the part before .supabase.co in SUPABASE_URL). The script refuses unless it equals the project the migrator URL points at. Set it ONLY in the dev .env, never in a CI env.
# CAREFLOW_DEV_PROJECT_REF=

# The CLOSED list of reasons a patient may be erased for (comma separated words, e.g. the clinic's own list). A privacy decision with NO default: unset means POST /v1/staff/patients/{id}/erase answers 503.
# CAREFLOW_ERASE_REASONS=

# The clinic's autonomy mode: shadow (a person decides everything), assisted or autonomous (BUILD-SPEC 12.1). A GOVERNANCE choice with NO default in code: unset or unrecognised means shadow, the most human mode.
# Switching a clinic to autonomous is a two-person act (an admin AND a doctor). Used by the Scheduling graph's approval matrix (careflow/autonomy.py).
# CAREFLOW_AUTONOMY_MODE=

# --- Phase 4 required settings (no defaults; unset = the feature reports 'not configured', it never guesses) ---
# CAREFLOW_REVIEW_REASON_CODES=          comma separated words: the picklist a reviewer picks a reject/edit reason from (the clinic decides)
# CAREFLOW_REVIEW_DEADLINE_MINUTES=      JSON {"<task kind>": minutes}: when a review task becomes overdue (escalates nurse -> doctor -> admin; nothing is ever approved by timeout)
# CAREFLOW_WATCHDOG_LIMITS=              JSON {"red_flag_minutes": n, "queue_age_seconds": n}
# CAREFLOW_CANARY_RATE=                  fraction of the review queue that is a canary (the spec says 0.01 to 0.02; at most 0.05 is accepted)
# CAREFLOW_RUBBER_STAMP_POLICY=          JSON {"min_decisions": n, "max_approval_rate": r, "min_median_seconds": s}
# CAREFLOW_AUTO_REVIEW_SAMPLE_RATE=      share of auto-approved cases pulled for an after-the-fact human review (the spec says about 0.05)
# CAREFLOW_LABEL_PSEUDONYM_KEY=          secret (16+ chars) for pseudonymizing reviewers in a training-label export
# CAREFLOW_TRACE_SAMPLE_RATE=            share of ordinary successful calls exported to a trace sink (errors, escalations, fallbacks and canaries are always kept)
# CAREFLOW_COST_PLATFORM_FLOOR=          P in the cost canvas, per month (a number)
# CAREFLOW_COST_REVIEWER_RATES=          JSON {"nurse": per-minute rate, "doctor": ..., "admin": ...} for F in the cost canvas
# CAREFLOW_SIGN_IN_URL=                  the link in an alert message

