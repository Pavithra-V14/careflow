    "/v1/iam/me": {
      "get": {
        "description": "The caller's own active profile: account type, status, and live staff role grants.\n\nA valid token alone is not enough: the caller needs an ACTIVE row in iam.accounts. A person who signed\nup with Supabase Auth but has no account here (or whose account is invited, suspended or closed) gets\nthe same 403, and learns nothing about which case it was.",
        "operationId": "me_v1_iam_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me"
      }
    },
    "/v1/staff/merges": {
      "post": {
        "description": "Step 1: propose linking the subordinate to the master (the caller signs). Not effective until a different front desk person approves.\nSTEP-UP IMPLEMENTED, CLAIM SHAPE PENDING LIVE VERIFICATION (docs/design/step-up-spike.md).\n401 step-up required, 404 unknown clinic/patient, 403 not front desk there, 409 refused (one fixed body), 422 invalid input.",
        "operationId": "propose_merge_v1_staff_merges_post",
        "parameters": [
          {
            "description": "Required on every write.",
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "description": "Required on every write.",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "title": "X-Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeMergeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MergeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Propose Merge",
        "tags": [
          "staff merges"
