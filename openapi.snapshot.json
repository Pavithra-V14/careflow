  "info": {
    "title": "CareFlow",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/iam/me": {
      "get": {
        "description": "The caller's own active profile: account type, status, and live staff role grants.\n\nA valid token alone is not enough: the caller needs an ACTIVE row in iam.accounts. A person who signed\nup with Supabase Auth but has no account here (or whose account is invited, suspended or closed) gets\nthe same 403, and learns nothing about which case it was.",
        "operationId": "me_v1_iam_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me"
      }
    },
    "/v1/staff/scheduling/bookings": {
      "get": {
        "description": "Confirmed bookings, soonest appointment first.",
        "operationId": "list_bookings_v1_staff_scheduling_bookings_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Bookings",
        "tags": [
          "staff scheduling"
        ]
      }
    },
    "/v1/staff/scheduling/bookings/{booking_id}/cancel": {
      "post": {
        "description": "Cancel a booking, free its slot, and return the ranked waitlist candidates. Nobody is contacted or booked.",
        "operationId": "cancel_booking_v1_staff_scheduling_bookings__booking_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "booking_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Booking Id",
              "type": "string"
            }
          },
          {
            "description": "Required on every write.",
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "description": "Required on every write.",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "title": "X-Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Cancel Booking",
        "tags": [
          "staff scheduling"
        ]
      }
    },
    "/v1/staff/scheduling/slots": {
      "get": {
        "description": "Open and held slots, soonest first, optionally for one provider and/or location.",
        "operationId": "list_slots_v1_staff_scheduling_slots_get",
        "parameters": [
          {
            "in": "query",
            "name": "provider_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Provider Id"
            }
          },
          {
            "in": "query",
            "name": "location_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Location Id"
            }
          },
          {
            "in": "query",
            "name": "starts_after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Starts After"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Slots",
        "tags": [
          "staff scheduling"
        ]
      }
    },
    "/v1/staff/scheduling/slots/{slot_id}/book": {
      "post": {
        "description": "Book an open slot (or one held for this patient) for `patient_id`. 409 if the slot is taken.",
        "operationId": "book_slot_v1_staff_scheduling_slots__slot_id__book_post",
        "parameters": [
          {
            "in": "path",
            "name": "slot_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Slot Id",
              "type": "string"
            }
          },
          {
            "description": "Required on every write.",
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "description": "Required on every write.",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "title": "X-Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Book Slot",
        "tags": [
          "staff scheduling"
        ]
      }
    },
